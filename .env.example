# ─────────────────────────────── Supabase ───────────────────────────────
# From your Supabase project: Settings → API.
#
# Copy this file to .env.local and put the real values there. .env.local is
# gitignored; this file is committed, so never paste a real key into it.

# Public by design. The browser needs both, and Supabase expects them to be
# visible: on their own they grant nothing, because row-level security plus the
# signed-in session decide what a request may read.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️  SECRET. This key BYPASSES ROW-LEVEL SECURITY COMPLETELY — one query with it
# reads every restoration case, benevolence amount, and confidential note in the
# database, whoever is signed in.
#
# Note the missing NEXT_PUBLIC_ prefix. That is deliberate and load-bearing: Next
# inlines anything so prefixed into the browser bundle. Only
# src/auth/supabase-admin.ts reads this, it is server-only, and no request path
# uses it. Set it only if you need administrative work with no signed-in person.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────── Database ───────────────────────────────
# Supabase project → Settings → Database → Connection string → URI.
# Use the pooled connection string for serverless (Vercel).
DATABASE_URL=

# ──────────────────────────────── Site ────────────────────────────────
# Where magic links and OAuth return to. Vercel is detected automatically; set
# this for a custom domain.
FOLD_SITE_URL=

# ──────────────────────────────── Demo ────────────────────────────────
# Runs over sample data with a viewer switch instead of sign-in. Always on
# locally; anywhere else it takes this explicit opt-in, so a deployment gets demo
# behaviour because someone asked for it. Leave unset once Supabase is
# configured — the switch disappears when a real session is available.
FOLD_DEMO_MODE=

# Optional: which sample person the demo starts as. Falls back to the least
# privileged viewer, never the most.
FOLD_DEV_VIEWER=
