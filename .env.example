# Postgres. Any Postgres works — a Supabase project, Neon, or a local install.
# The tier model is enforced in the data access layer, so this connection
# should use a role with ordinary table privileges, not a superuser.
DATABASE_URL=postgresql://user:password@localhost:5432/fold

# Runs the app over sample data with a viewer switch standing in for sign-in.
# Always on locally; anywhere else it takes this explicit opt-in, so a deployment
# gets demo behaviour because someone asked for it rather than because of which
# build command ran. Leave it unset and a deployed instance refuses to serve
# people records at all — the right default until real auth exists.
#
# Set to 1 on Vercel to make a preview deployment viewable. Note that it leaves
# the deployment readable by anyone with the URL.
FOLD_DEMO_MODE=

# Optional: which sample person to view as before any cookie is set. Falls back
# to the least privileged viewer, never the most.
FOLD_DEV_VIEWER=
