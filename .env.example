# Postgres. Any Postgres works — a Supabase project, Neon, or a local install.
# The tier model is enforced in the data access layer, so this connection
# should use a role with ordinary table privileges, not a superuser.
DATABASE_URL=postgresql://user:password@localhost:5432/fold

# Development only. Lets you view the app as a given person to exercise the
# confidentiality tiers before real auth exists. Ignored when NODE_ENV is
# production — see src/data/auth.ts.
FOLD_DEV_VIEWER=
